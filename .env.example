# Copy this file to .env (same folder) and fill in the values.
# Never commit .env to GitHub.

# --- AI (pick one provider) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# To use Amazon Bedrock instead, set AI_PROVIDER=bedrock and fill these in.
# Bedrock uses your AWS credentials (locally) or the service's IAM role (on AWS); no API key needed.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# --- Security ---
# Any long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# --- Database ---
# Leave blank to use a local SQLite file (backend/cashpilot.db).
# Production example: postgresql://cashpilot:PASSWORD@your-rds-endpoint:5432/cashpilot
DATABASE_URL=

# --- Receipt storage ---
# Leave blank to save receipts in backend/uploads/. Set a bucket name in production.
S3_BUCKET=

# --- Misc ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
